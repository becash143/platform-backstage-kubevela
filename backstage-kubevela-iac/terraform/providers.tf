terraform {
  required_version = ">= 1.5.0"

  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.31"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.13"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# Cloud-agnostic: points at whatever kubeconfig context is active.
# Works against EKS, GKE, AKS, kind, k3s, etc. Swap the config_path /
# config_context for a cloud-managed auth block (aws eks, exec plugin, etc.)
# if you don't want to rely on a static kubeconfig file.
provider "kubernetes" {
  config_path    = var.kubeconfig_path
  config_context = var.kube_context
}

provider "helm" {
  kubernetes {
    config_path    = var.kubeconfig_path
    config_context = var.kube_context
  }
}
